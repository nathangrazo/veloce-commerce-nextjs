# Required in production (minimum 16 characters). Used to sign HTTP-only session cookies via HMAC-SHA256.
SESSION_SECRET=replace-with-a-32-char-random-secret

# Optional: Upstash Redis / Vercel KV REST credentials for persistent storage across serverless instances.
# When omitted locally, the app falls back to a mutex-locked local JSON store in ./data/store.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
